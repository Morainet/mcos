<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- This app only exports its own records; SDK platform permissions are unnecessary. -->
    <uses-permission tools:node="removeAll" />
    <application android:name=".SampleApplication" android:label="MCOS Record Export"
        android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <receiver tools:node="removeAll" />
        <service tools:node="removeAll" />
        <provider tools:node="removeAll" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
