<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shell window theme. Transparent system bars so the app draws
         edge-to-edge (enableEdgeToEdge in MainActivity finalizes the icon
         style); the window background matches the conversation surface before
         Compose draws its first frame. -->
    <style name="Theme.McosShell" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mcos_window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.McosShell.Starting" parent="Base.Theme.McosShell.Starting" />

    <style name="Base.Theme.McosShell.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mcos_splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/mcos_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.McosShell</item>
        <item name="android:statusBarColor">@color/mcos_splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
